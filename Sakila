-- Os filmes mais alugados de cada categoria.

with ranking as (
select
f.title as filme,
cat.name as categoria,
count(r.rental_id) as aluguel,
row_number() over (partition by cat.category_id order by count(r.rental_id) desc) as posicao
from rental r
join inventory i
on r.inventory_id = i.inventory_id
join film f
on f.film_id = i.film_id
join film_category fc
on f.film_id = fc.film_id
join category cat 
on fc.category_id = cat.category_id
group by f.film_id, cat.category_id
)
select
filme,
categoria,
aluguel
from ranking
where posicao = 1
order by aluguel desc;


-- Os filmes que têm mais de 100 cópias disponíveis.

select
f.film_id,
f.title,
count(i.inventory_id) as copias
from film f
join inventory i
on f.film_id = i.film_id
group by f.film_id
having count(i.inventory_id) > 100
order by copias desc;


-- Clientes que fizeram mais de 5 locações no último mês.

select
c.customer_id,
concat(c.first_name, ' ', c.last_name) as cliente,
count(r.rental_id) as locacoes
from rental r
join customer c
on r.customer_id = c.customer_id
where r.rental_date >= date_sub(curdate(), interval 1 month)
group by c.customer_id
having locacoes > 5
order by locacoes desc;
